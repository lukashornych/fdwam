[Desktop Entry]
Type=Application
Version=1.5
Name=Example
Comment=Web app: https://example.com/
Exec=@BIN@/floorp --no-remote --profile @DATA@/fdwam/profiles/floorp-app --name fdwam-floorp-app --class fdwam-floorp-app https://example.com/
Icon=applications-internet
Terminal=false
StartupNotify=true
StartupWMClass=fdwam-floorp-app
Categories=Network;
X-Fdwam-Id=floorp-app
X-Fdwam-Browser=floorp
