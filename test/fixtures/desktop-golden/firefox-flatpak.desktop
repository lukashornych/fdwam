[Desktop Entry]
Type=Application
Version=1.5
Name=Netflix
Comment=Web app: https://www.netflix.com/
Exec=@FLATPAK_USER@/org.mozilla.firefox --no-remote --profile @HOME@/.var/app/org.mozilla.firefox/data/fdwam-profiles/netflix --name fdwam-netflix --class fdwam-netflix https://www.netflix.com/
Icon=applications-internet
Terminal=false
StartupNotify=true
StartupWMClass=fdwam-netflix
Categories=Network;
X-Fdwam-Id=netflix
X-Fdwam-Browser=firefox
