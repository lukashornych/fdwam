[Desktop Entry]
Type=Application
Version=1.5
Name=Ex & "Co" 100%
Comment=Web app: https://example.com/a%20b/c?x=1&y=2;z=3&q="quoted"
Exec=@BIN@/brave --user-data-dir=@DATA@/fdwam/profiles/example --profile-directory=fdwam-example --no-first-run --no-default-browser-check --ozone-platform-hint=auto --password-store=basic --enable-features=A,B "--lang=en US" "--app=https://example.com/a%%20b/c?x=1&y=2;z=3&q=\\"quoted\\""
Icon=applications-internet
Terminal=false
StartupNotify=true
StartupWMClass=brave-example.com__a%20b_c-fdwam-example
Categories=Office;
X-Fdwam-Id=example
X-Fdwam-Browser=brave
