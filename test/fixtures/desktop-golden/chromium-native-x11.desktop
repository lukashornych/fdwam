[Desktop Entry]
Type=Application
Version=1.5
Name=Netflix
Comment=Web app: https://www.netflix.com/
Exec=@BIN@/chromium --user-data-dir=@DATA@/fdwam/profiles/netflix --profile-directory=fdwam-netflix --no-first-run --no-default-browser-check --ozone-platform=x11 --class=fdwam-netflix --app=https://www.netflix.com/
Icon=applications-internet
Terminal=false
StartupNotify=true
StartupWMClass=fdwam-netflix
Categories=Network;
X-Fdwam-Id=netflix
X-Fdwam-Browser=chromium
