[Desktop Entry]
Type=Application
Version=1.5
Name=Netflix
Comment=Web app: https://netflix.com/browse?x=1#frag
Exec=@BIN@/google-chrome-stable --user-data-dir=@DATA@/fdwam/profiles/netflix --profile-directory=fdwam-netflix --no-first-run --no-default-browser-check --ozone-platform-hint=auto "--app=https://netflix.com/browse?x=1#frag"
Icon=applications-internet
Terminal=false
StartupNotify=true
StartupWMClass=chrome-netflix.com__browse-fdwam-netflix
Categories=Network;
X-Fdwam-Id=netflix
X-Fdwam-Browser=chrome
